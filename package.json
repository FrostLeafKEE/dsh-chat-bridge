{
  "name": "dsh-chat-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "DSH 桌面聊天区插件：官方网页聊天、历史采集、直接导入原生工作会话上下文",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "docs/*.md",
    "README.md",
    "HANDOFF.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.en.md",
    "assets/hero.png",
    "assets/lang-zh.svg",
    "assets/lang-en.svg",
    "assets/README.md",
    "assets/hero.prompt.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-gateway"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.2.0-rc.2"
  },
  "scripts": {
    "build": "npm run build:types && npm run build:js",
    "build:types": "tsc -p tsconfig.build.json",
    "build:js": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --config .oxlintrc.json src tests build scripts",
    "test": "npm run build:js && vitest run",
    "test:watch": "vitest",
    "pack": "npm pack --pack-destination dist",
    "verify": "npm run typecheck && npm run lint && npm run build && npm test",
    "clean": "node scripts/clean.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.0-rc.2",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.86.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "6.0.3",
    "vitest": "^4.1.8",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-gateway": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.0-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrostLeafKEE/dsh-chat-bridge.git"
  },
  "homepage": "https://github.com/FrostLeafKEE/dsh-chat-bridge#readme",
  "bugs": {
    "url": "https://github.com/FrostLeafKEE/dsh-chat-bridge/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "desktop-plugin",
    "webview",
    "workspace",
    "conversation-import"
  ]
}
